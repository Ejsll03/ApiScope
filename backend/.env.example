# Copia este archivo a ".env" y completa los valores reales.
# ".env" NUNCA debe subirse al repositorio (ya esta en .gitignore).

# Usados solo si storage.strategy = "postgresql" en logger.config.json
# Estos valores coinciden con docker-compose.yml (raiz del repo) -- si
# levantaste ese Postgres con `docker compose up -d`, descomenta tal cual.
# Si usas un Postgres local propio (no Docker), reemplaza por tus valores.
# (El puerto va como numero literal en logger.config.json, no por env var,
# porque JSON no tiene forma de escribir "${VAR}" como numero.)
# LOGGER_DB_HOST=localhost
# LOGGER_DB_USER=apiscope
# LOGGER_DB_PASSWORD=apiscope-dev
# LOGGER_DB_NAME=apiscope

# Usados solo si monitoring.auth.enabled = true en logger.config.json
# LOGGER_MONITORING_USER=admin
# LOGGER_MONITORING_PASSWORD=change-me
