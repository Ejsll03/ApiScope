# Copia este archivo a ".env" y completa los valores reales.
# ".env" NUNCA debe subirse al repositorio (ya esta en .gitignore).

# Usados solo si storage.strategy = "postgresql" en logger.config.json
# LOGGER_DB_HOST=localhost
# LOGGER_DB_USER=apiscope
# LOGGER_DB_PASSWORD=change-me
# LOGGER_DB_NAME=apiscope

# Usados solo si monitoring.auth.enabled = true en logger.config.json
# LOGGER_MONITORING_USER=admin
# LOGGER_MONITORING_PASSWORD=change-me
