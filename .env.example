# Copia este archivo a "backend/.env" para la app demo, o a la raíz del
# proyecto cuando uses el paquete desde otra aplicación.

# Variables de PostgreSQL usadas solo cuando storage.strategy = "postgresql"
LOGGER_DB_HOST=localhost
LOGGER_DB_USER=apiscope
LOGGER_DB_PASSWORD=change-me
LOGGER_DB_NAME=apiscope

# Variables de autenticación del monitoreo usadas solo cuando auth.enabled = true
LOGGER_MONITORING_USER=admin
LOGGER_MONITORING_PASSWORD=change-me